#include <stdio.h>
int main()
{
    int a[10][10], n, i, j, d;
    printf("Enter order of matrix: ");
    scanf("%d", &n);
    printf("Enter matrix elements:\n");

    for(i = 0; i < n; i++)
    {
        for(j = 0; j < n; j++)
        {
            scanf("%d", &a[i][j]);
        }
    }
    printf("Diagonal traversal:\n");

    for(d = 0; d < 2 * n - 1; d++)
    {
        for(i = 0; i < n; i++)
        {
            j = d - i;

            if(j >= 0 && j < n)
            {
                printf("%d ", a[i][j]);
            }
        }
        printf("\n");
    }
    return 0;
}
