#include <stdio.h>
int main()
{
    int n, i;
    int factorial = 1;
    
    printf("Enter the number for which you want to find the factorial: ");
    scanf("%d", &n);

    for(i = 1; i <= n; i++)
    {
        factorial = factorial * i;
    }
    
    printf("Factorial of %d is: %d\n", n, factorial);
    
    return 0;
}
