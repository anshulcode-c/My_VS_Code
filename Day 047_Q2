#include <stdio.h>
int main()
{
    char str[200], word[200];
    int i, start = 0, len = 0;
    int max = 0, pos = 0, j;
    printf("Enter a sentence: ");
    fgets(str, sizeof(str), stdin);

    for(i = 0; ; i++)
    {
        if(str[i] == ' ' || str[i] == '\0' ||
           str[i] == '\n')
        {
            if(len > max)
            {
                max = len;
                pos = start;
            }

            len = 0;
            start = i + 1;
        }
        else
        {
            len++;
        }

        if(str[i] == '\0' || str[i] == '\n')
            break;
    }

    for(j = 0; j < max; j++)
    {
        word[j] = str[pos + j];
    }

    word[j] = '\0';
    printf("Longest word = %s\n", word);
    printf("Length = %d", max);
    return 0;
}
