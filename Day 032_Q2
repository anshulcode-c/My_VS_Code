#include <stdio.h>
int main()
{
    long long n;
    int count[10] = {0};
    int digit, i, max = 0, maxDigit = 0;
    printf("Enter a number: ");
    scanf("%lld", &n);
    if(n < 0)
        n = -n;

    if(n == 0)
        count[0] = 1;

    while(n > 0)
    {
        digit = n % 10;
        count[digit]++;
        n = n / 10;
    }
    for(i = 0; i < 10; i++)
    {
        if(count[i] > max)
        {
            max = count[i];
            maxDigit = i;
        }
    }
    printf("Most frequent digit = %d\n", maxDigit);
    printf("Number of occurrences = %d\n", max);
    return 0;
}
