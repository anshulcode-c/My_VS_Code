#include <stdio.h>
int main()
{
    char str[100];
    int i, last = 0;
    printf("Enter your full name: ");
    fgets(str, sizeof(str), stdin);

    for(i = 0; str[i] != '\0'; i++)
    {
        if(str[i] == ' ' && str[i + 1] != ' ' &&
           str[i + 1] != '\n' && str[i + 1] != '\0')
        {
            last = i + 1;
        }
    }
    printf("Name = ");

    if(last == 0)
    {
        printf("%s", str);
    }
    else
    {
        if(str[0] != ' ')
            printf("%c. ", str[0]);

        for(i = 1; i < last; i++)
        {
            if(str[i - 1] == ' ' && str[i] != ' ')
            {
                printf("%c. ", str[i]);
            }
        }

        for(i = last; str[i] != '\0' && str[i] != '\n'; i++)
        {
            printf("%c", str[i]);
        }
    }
    return 0;
}
